generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MemberRole {
  OPERATOR_OWNER
  OPERATOR_DISPATCHER
  OPERATOR_VIEWER
  DRIVER
}

enum OperatorStatus {
  LEAD
  CONTRACTED
  ONBOARDING
  DOCS_PENDING
  UNDER_REVIEW
  APPROVED
  GENERATING
  ASSISTANT_TRAINING
  SANDBOX
  CLIENT_REVIEW
  LIVE
  RESTRICTED
  SUSPENDED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  active Boolean @default(true)
  platformRole PlatformRole @default(USER)
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  memberships OrganizationMember[]
  auditLogs AuditLog[]
  documentUploads ComplianceDocument[] @relation("DocumentUploader")
  documentReviews ComplianceReview[]
  operatorApprovals OperatorProfile[] @relation("OperatorApprover")
  dispatchDecisions DispatchDecision[]
  driverAccounts Driver[]
  driverActions DriverAction[]
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
  @@index([expires])
}

model LoginThrottle {
  key String @id
  attempts Int @default(1)
  windowStart DateTime @default(now())
}

model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  brand BrandProfile?
  members OrganizationMember[]
  operator OperatorProfile?
  auditLogs AuditLog[]
  complianceRequirements ComplianceRequirement[]
  services Service[]
  vehicles Vehicle[]
  drivers Driver[]
  timeZone String @default("Europe/Lisbon")
  serviceSchedules ServiceSchedule[]
  serviceVehicles ServiceVehicle[]
  driverAvailability DriverAvailability[]
  resourceBlocks ResourceBlock[]
  bookings Booking[]
  customers Customer[]
}

model OrganizationMember {
  id String @id @default(cuid())
  organizationId String
  userId String
  role MemberRole
  active Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([organizationId, userId])
  @@index([userId, active])
}

model OperatorProfile {
  id String @id @default(cuid())
  organizationId String @unique
  responsibleName String
  contactEmail String
  contactPhone String
  plan String
  setupPaid Boolean @default(false)
  monthlyPriceCents Int
  currency String @default("EUR")
  primaryLanguage String @default("pt")
  status OperatorStatus @default(LEAD)
  version Int @default(0)
  approvedAt DateTime?
  approvedById String?
  complianceNote String?
  calendarVersion Int @default(0)
  approvedBy User? @relation("OperatorApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([status])
}

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRING
  EXPIRED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

model ComplianceRequirement {
  id String @id @default(cuid())
  organizationId String
  title String
  requiresExpiry Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents ComplianceDocument[]
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model ComplianceDocument {
  id String @id @default(cuid())
  organizationId String
  requirementId String
  revision Int
  fileName String
  mimeType String
  size Int
  sha256 String
  data Bytes
  expiresOn DateTime? @db.Date
  status DocumentStatus @default(PENDING)
  uploadedById String
  createdAt DateTime @default(now())
  requirement ComplianceRequirement @relation(fields: [requirementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy User @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  review ComplianceReview?
  @@unique([requirementId, revision])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model ComplianceReview {
  id String @id @default(cuid())
  organizationId String
  documentId String @unique
  reviewerId String
  decision ReviewDecision
  note String?
  createdAt DateTime @default(now())
  document ComplianceDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  @@unique([documentId, organizationId])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  organizationId String?
  actorId String
  action String
  // Only operational metadata, never tokens, SMTP credentials or document content.
  metadata Json
  createdAt DateTime @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt])
}

// Operator Core: registries only. Scheduling and eligibility belong to later sprints.
enum PricingType {
  PER_PERSON
  PER_GROUP
}
enum VehicleType {
  JEEP
  CAR
  VAN
  MINIBUS
  BUS
}
enum DriverStatus {
  INVITED
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Service {
  id String @id @default(cuid())
  organizationId String
  name String
  description String
  durationMinutes Int
  pricingType PricingType
  basePriceCents Int
  currency String @default("EUR")
  capacity Int
  meetingPoint String
  pickupAvailable Boolean @default(false)
  pickupRules String @default("")
  bookings Booking[]
  schedules ServiceSchedule[]
  compatibleVehicles ServiceVehicle[]
  languages String[]
  active Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, active, name])
}
model Vehicle {
  id String @id @default(cuid())
  organizationId String
  name String
  type VehicleType
  registration String
  capacity Int
  features String[]
  compatibleServices ServiceVehicle[]
  dispatchDecisions DispatchDecision[]
  occupations BookingOccupancy[]
  blocks ResourceBlock[]
  active Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, registration])
  @@unique([id, organizationId])
  @@index([organizationId, active, name])
}
model Driver {
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  actions DriverAction[]
  @@unique([organizationId, userId])
  id String @id @default(cuid())
  organizationId String
  name String
  phone String
  email String
  languages String[]
  status DriverStatus @default(PENDING)
  dispatchDecisions DispatchDecision[]
  availability DriverAvailability[]
  occupations BookingOccupancy[]
  blocks ResourceBlock[]
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
}

model ServiceSchedule {
  id String @id @default(cuid())
  organizationId String
  serviceId String
  weekday Int
  departureMinutes Int
  validFrom DateTime @db.Date
  validUntil DateTime @db.Date
  bufferBeforeMinutes Int @default(0)
  bufferAfterMinutes Int @default(0)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, serviceId, active])
}
model ServiceVehicle {
  id String @id @default(cuid())
  organizationId String
  serviceId String
  vehicleId String
  active Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([organizationId, serviceId, vehicleId])
  @@index([organizationId, serviceId, active])
}
model DriverAvailability {
  id String @id @default(cuid())
  organizationId String
  driverId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, startsAt, endsAt])
  @@index([organizationId, driverId, active])
}
model ResourceBlock {
  id String @id @default(cuid())
  organizationId String
  vehicleId String?
  driverId String?
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  reason String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver Driver? @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, startsAt, endsAt])
}

enum BookingStatus {
  DRIVER_ACCEPTED
  DRIVER_DECLINED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  ASSIGNED
  CONFIRMED
  CANCELLED
}
model Customer {
  id String @id @default(cuid())
  organizationId String
  name String
  email String
  phone String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bookings Booking[]
  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
}
model Booking {
  id String @id @default(cuid())
  organizationId String
  serviceId String
  customerId String
  idempotencyKey String
  requestHash String
  mode String @default("SANDBOX")
  status BookingStatus @default(CONFIRMED)
  version Int @default(0)
  passengers Int
  language String?
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  timeZone String
  serviceName String
  pricingType PricingType
  unitPriceCents Int
  totalPriceCents Int
  currency String
  meetingPoint String
  pickupRules String
  pickup String
  notes String
  source String
  createdAt DateTime @default(now())
  cancelledAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  customer Customer @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  occupancy BookingOccupancy?
  driverActions DriverAction[]
  events BookingEvent[]
  dispatchDecisions DispatchDecision[]
  @@unique([id, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, startsAt, id])
}
model BookingOccupancy {
  id String @id @default(cuid())
  organizationId String
  bookingId String @unique
  vehicleId String
  driverId String
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  releasedAt DateTime?
  @@unique([bookingId, organizationId])
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver Driver @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, startsAt, endsAt])
}
model BookingEvent {
  id String @id @default(cuid())
  organizationId String
  bookingId String
  type BookingStatus
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, bookingId, createdAt])
}

enum DispatchOutcome {
  ASSIGNED
  NO_CANDIDATE
}
enum DispatchMode {
  AUTO
  MANUAL
}
model DispatchDecision {
  id String @id @default(cuid())
  organizationId String
  bookingId String
  actorId String
  idempotencyKey String
  requestHash String
  bookingVersion Int
  mode DispatchMode
  outcome DispatchOutcome
  driverId String?
  vehicleId String?
  score Int?
  factors Json
  reason String
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  driver Driver? @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, bookingId, createdAt])
}

enum DriverActionType {
  ACCEPT
  DECLINE
  ARRIVE
  START
  COMPLETE
}
model DriverAction {
  id String @id @default(cuid())
  organizationId String
  bookingId String
  driverId String
  actorId String
  idempotencyKey String
  requestHash String
  bookingVersion Int
  type DriverActionType
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver Driver @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, bookingId, type])
}

model BrandProfile {
  organizationId String @id
  displayName String
  primaryColor String
  secondaryColor String
  logo Bytes?
  hasLogo Boolean @default(false)
  icon192 Bytes
  icon512 Bytes
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}
