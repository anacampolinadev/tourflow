generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  SUPER_ADMIN
}

enum MemberRole {
  OPERATOR_OWNER
  OPERATOR_DISPATCHER
  OPERATOR_VIEWER
  DRIVER
}

enum OperatorStatus {
  LEAD
  CONTRACTED
  ONBOARDING
  DOCS_PENDING
  UNDER_REVIEW
  APPROVED
  GENERATING
  ASSISTANT_TRAINING
  SANDBOX
  CLIENT_REVIEW
  LIVE
  RESTRICTED
  SUSPENDED
}

model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  active Boolean @default(true)
  platformRole PlatformRole @default(USER)
  createdAt DateTime @default(now())
  accounts Account[]
  sessions Session[]
  memberships OrganizationMember[]
  auditLogs AuditLog[]
  documentUploads ComplianceDocument[] @relation("DocumentUploader")
  documentReviews ComplianceReview[]
  operatorApprovals OperatorProfile[] @relation("OperatorApprover")
}

model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
  @@index([expires])
}

model LoginThrottle {
  key String @id
  attempts Int @default(1)
  windowStart DateTime @default(now())
}

model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members OrganizationMember[]
  operator OperatorProfile?
  auditLogs AuditLog[]
  complianceRequirements ComplianceRequirement[]
  services Service[]
  vehicles Vehicle[]
  drivers Driver[]
}

model OrganizationMember {
  id String @id @default(cuid())
  organizationId String
  userId String
  role MemberRole
  active Boolean @default(true)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@unique([organizationId, userId])
  @@index([userId, active])
}

model OperatorProfile {
  id String @id @default(cuid())
  organizationId String @unique
  responsibleName String
  contactEmail String
  contactPhone String
  plan String
  setupPaid Boolean @default(false)
  monthlyPriceCents Int
  currency String @default("EUR")
  primaryLanguage String @default("pt")
  status OperatorStatus @default(LEAD)
  version Int @default(0)
  approvedAt DateTime?
  approvedById String?
  complianceNote String?
  approvedBy User? @relation("OperatorApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@index([status])
}

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRING
  EXPIRED
}

enum ReviewDecision {
  APPROVED
  REJECTED
}

model ComplianceRequirement {
  id String @id @default(cuid())
  organizationId String
  title String
  requiresExpiry Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents ComplianceDocument[]
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model ComplianceDocument {
  id String @id @default(cuid())
  organizationId String
  requirementId String
  revision Int
  fileName String
  mimeType String
  size Int
  sha256 String
  data Bytes
  expiresOn DateTime? @db.Date
  status DocumentStatus @default(PENDING)
  uploadedById String
  createdAt DateTime @default(now())
  requirement ComplianceRequirement @relation(fields: [requirementId, organizationId], references: [id, organizationId], onDelete: Restrict)
  uploadedBy User @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  review ComplianceReview?
  @@unique([requirementId, revision])
  @@unique([id, organizationId])
  @@index([organizationId])
}

model ComplianceReview {
  id String @id @default(cuid())
  organizationId String
  documentId String @unique
  reviewerId String
  decision ReviewDecision
  note String?
  createdAt DateTime @default(now())
  document ComplianceDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewer User @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  @@unique([documentId, organizationId])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  organizationId String?
  actorId String
  action String
  // Only operational metadata, never tokens, SMTP credentials or document content.
  metadata Json
  createdAt DateTime @default(now())
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt])
}

// Operator Core: registries only. Scheduling and eligibility belong to later sprints.
enum PricingType {
  PER_PERSON
  PER_GROUP
}
enum VehicleType {
  JEEP
  CAR
  VAN
  MINIBUS
  BUS
}
enum DriverStatus {
  INVITED
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}
model Service {
  id String @id @default(cuid())
  organizationId String
  name String
  description String
  durationMinutes Int
  pricingType PricingType
  basePriceCents Int
  currency String @default("EUR")
  capacity Int
  meetingPoint String
  pickupAvailable Boolean @default(false)
  pickupRules String @default("")
  languages String[]
  active Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([id, organizationId])
  @@index([organizationId, active, name])
}
model Vehicle {
  id String @id @default(cuid())
  organizationId String
  name String
  type VehicleType
  registration String
  capacity Int
  features String[]
  active Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, registration])
  @@unique([id, organizationId])
  @@index([organizationId, active, name])
}
model Driver {
  id String @id @default(cuid())
  organizationId String
  name String
  phone String
  email String
  languages String[]
  status DriverStatus @default(PENDING)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, status, name])
}
