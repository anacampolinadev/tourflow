# Local development only. Never use these database credentials in production.
DATABASE_URL=postgresql://tourflow:tourflow@localhost:5432/tourflow
AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
