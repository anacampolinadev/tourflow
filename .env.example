# Local development only. Never use these database credentials in production.
DATABASE_URL=postgresql://tourflow:tourflow@localhost:5432/tourflow
AUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Mailpit local SMTP. Production requires authenticated SMTP with TLS.
EMAIL_SERVER_HOST=localhost
EMAIL_SERVER_PORT=1025
EMAIL_SERVER_USER=local
EMAIL_SERVER_PASSWORD=local
EMAIL_FROM=tourflow@example.test

# Retell preflight only; disabled by default. Never commit a real key.
# Use the server-side API key designated by Retell for webhook verification.
RETELL_INGRESS_ENABLED=false
RETELL_API_KEY=
# Exact public HTTPS destination registered on the dedicated Retell agent.
RETELL_WEBHOOK_URL=
